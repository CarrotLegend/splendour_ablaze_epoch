{
  "multipart": [
    {
      "apply": {
        "model": "splendour_ablaze_epoch:block/cerasus_japonica_fence_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "splendour_ablaze_epoch:block/cerasus_japonica_fence",
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "splendour_ablaze_epoch:block/cerasus_japonica_fence",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "splendour_ablaze_epoch:block/cerasus_japonica_fence",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "splendour_ablaze_epoch:block/cerasus_japonica_fence",
        "y": 90,
        "uvlock": true
      }
    }
  ]
}